{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pau & Tecla question bank",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id", "pool", "topic", "difficulty", "questionCa", "answerCa",
      "reviewStatus", "factualReviewed", "languageReviewed", "active",
      "sourceType", "contentVersion"
    ],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "pool": {"enum": ["PAU", "TECLA", "TECLA_PAU", "PAU_TECLA", "TP"]},
      "topic": {"type": "string", "minLength": 1},
      "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
      "questionCa": {"type": "string", "minLength": 5},
      "answerCa": {"type": "string", "minLength": 1},
      "reviewStatus": {"enum": ["DRAFT", "APPROVED", "ARCHIVED"]},
      "factualReviewed": {"type": "boolean"},
      "languageReviewed": {"type": "boolean"},
      "active": {"type": "boolean"},
      "sourceType": {"type": "string"},
      "notes": {"type": "string"},
      "contentVersion": {"type": "integer", "minimum": 1}
    },
    "additionalProperties": false
  }
}
